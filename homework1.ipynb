   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def f(x):\n",
    "    return np.log(x+1)-x\n",
    "\n",
    "x_vals=np.linspace(-0.9,2,100)\n",
    "y_vals=f(x_vals)\n",
    "\n",
    "plt.plot(x_vals, y_vals, label=\"f(x)=ln(x+1)-x\", color=\"blue\")\n",
    "plt.axhline(0,color=\"red\", linestyle=\"--\")\n",
    "plt.grid()\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  }
 ],
